{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "muuttohaukat/landing-nearby",
  "title": "Lähikunnat",
  "category": "muuttohaukat",
  "icon": "networking",
  "description": "Oman alueen kunnat linkkeinä ja linkki alueen toimipistesivulle. Enintään 15 linkkiä.",
  "supports": { "html": false, "multiple": false, "reusable": false, "align": false, "anchor": true },
  "attributes": {
    "background": {
      "type": "string",
      "default": "white",
      "enum": ["white", "yellow", "black"]
    },
    "anchor": { "type": "string", "default": "lahikunnat" },
    "links": { "type": "array", "default": [] },
    "hub": { "type": "string", "default": "" },
    "hubLabel": { "type": "string", "default": "" },
    "max": { "type": "number", "default": 15 }
  },
  "textdomain": "muuttohaukat",
  "editorScript": [
    "file:../landing-shared/background-panel.js",
    "file:./index.js"
  ],
  "style": "file:./style.css",
  "editorStyle": "file:./style.css",
  "render": "file:./render.php"
}
